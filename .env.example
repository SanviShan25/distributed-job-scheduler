# Copy to .env and replace every value before running `docker compose up`.
# .env is git-ignored; never commit real credentials.

# Postgres (only applied when the pgdata volume is first created)
POSTGRES_DB=jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=change-me-postgres

# Redis (requirepass)
REDIS_PASSWORD=change-me-redis

# API keys accepted in the X-API-Key header (comma-separated, no spaces). Generate e.g. with:
#   openssl rand -hex 32
API_KEYS=change-me-api-key

# POST /jobs token bucket per API key: burst size and sustained submissions/second
RATE_LIMIT_CAPACITY=200
RATE_LIMIT_REFILL_PER_SECOND=50

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Job-processing threads per worker container
WORKER_CONCURRENCY=4

# --- Used by the scripts in scripts/ and by local IDE runs -----------------------------------------
# API_KEY=change-me-api-key
# For running the app from an IDE against the dev override ports:
# DB_URL=jdbc:postgresql://127.0.0.1:5433/jobs
# DB_PASSWORD=change-me-postgres
# REDIS_HOST=localhost

# --- PulseCheck email ----------------------------------------------------------------------------------
# Where the web app lives; links in emails point here. With PULSECHECK_EMAIL_PROVIDER=logging it must be a
# localhost URL (the app refuses to start otherwise, because the logging sender prints working links).
PULSECHECK_APP_BASE_URL=http://localhost:8080
# logging = write emails to the API/worker logs (local development); resend = send through Resend.
PULSECHECK_EMAIL_PROVIDER=logging
# Resend API key (https://resend.com/api-keys). Required when PULSECHECK_EMAIL_PROVIDER=resend.
RESEND_API_KEY=change-me-resend-api-key
# Sender. onboarding@resend.dev works without a domain but only delivers to your own Resend account
# email; after verifying a domain in Resend use e.g. PulseCheck <alerts@yourdomain.com>.
EMAIL_FROM=PulseCheck <onboarding@resend.dev>

# --- PulseCheck public demo ----------------------------------------------------------------------------
# true = "Try the demo" gives each visitor a private sandbox account for 3 hours (no emails, max 20 at once).
PULSECHECK_DEMO_ENABLED=false
# Comma-separated addresses that may sign up; empty = anyone. Useful when email can only reach your own
# address (e.g. Resend without a verified domain).
PULSECHECK_SIGNUP_ALLOWED_EMAILS=
