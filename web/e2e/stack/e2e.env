# Settings for the throw-away end-to-end test stack (stack.sh). Not secrets: the stack runs on this
# machine (or a CI runner) only, with nothing published but the web app on localhost:8080, and is deleted
# afterwards. Never reuse these values anywhere real.
POSTGRES_PASSWORD=e2e-only-postgres
REDIS_PASSWORD=e2e-only-redis
API_KEYS=e2e-only-api-key
GRAFANA_ADMIN_PASSWORD=e2e-only-grafana
WORKER_CONCURRENCY=2

# Emails are written to the logs, never sent (requires a localhost base URL).
PULSECHECK_EMAIL_PROVIDER=logging
PULSECHECK_APP_BASE_URL=http://localhost:8080
RESEND_API_KEY=
EMAIL_FROM=PulseCheck <e2e@example.com>

# What the public demo will run with: demo on, sign-ups limited.
PULSECHECK_DEMO_ENABLED=true
PULSECHECK_SIGNUP_ALLOWED_EMAILS=owner@example.com
